# Copie ce fichier en .env.local puis redémarre le serveur (npm run dev).

# Source des matchs : "api" (The Odds API + SportScore) ou "mock" (démo locale, par défaut).
NEXT_PUBLIC_MATCH_SOURCE=api

# Clé The Odds API (gratuite sur https://the-odds-api.com, 500 crédits / mois).
# Elle reste côté serveur : ne jamais la préfixer par NEXT_PUBLIC_.
ODDS_API_KEY=

# Délai entre deux mises à jour des cotes, en minutes (défaut 360 = 6 h).
# Chaque mise à jour coûte ~1 crédit par tournoi de tennis actif.
ODDS_REFRESH_MINUTES=360

# Délai entre deux mises à jour des scores SportScore, en minutes (défaut 3).
# SportScore gratuit : ~1 000 requêtes / 24 h / IP.
SCORES_REFRESH_MINUTES=3

# Les classements ESPN sont mis à jour automatiquement chaque lundi (rien à configurer).

# Dossier où le serveur garde les matchs synchronisés (défaut .data/).
# DATA_DIR=.data
